{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "ui_kits/life-os/**",
              "ui_kits/life-os/components/**",
              "ui_kits/life-os/data/**",
              "ui_kits/life-os/lib/**",
              "ui_kits/life-os/pages/**",
              "ui_kits/life-os/pages/calendar/**",
              "ui_kits/life-os/pages/home/**",
              "ui_kits/life-os/pages/medications/**",
              "ui_kits/life-os/profile/**",
              "ui_kits/life-os/profile/cards/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Onest|Work Sans|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Onest, Work Sans, JetBrains Mono."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
