LIFEOS_ENVIRONMENT=development
LIFEOS_DATABASE_URL=postgresql+psycopg://<user>:<password>@127.0.0.1:5432/lifeos
LIFEOS_BOOTSTRAP_TOKEN=replace-with-at-least-32-random-characters
LIFEOS_ALLOWED_HOSTS=["localhost","127.0.0.1"]
LIFEOS_ALLOWED_ORIGINS=["http://localhost:5173"]
LIFEOS_COOKIE_SECURE=false
LIFEOS_SESSION_TTL_SECONDS=2592000
LIFEOS_SESSION_TOUCH_INTERVAL_SECONDS=900
LIFEOS_MAX_SNAPSHOT_BYTES=5242880
