{
  "id": "lender-e-daily-full-early-payoff",
  "description": "Synthetic lender E: 0.1 %/day, the payment day accrues first (next_day), full early repayment without a fee.",
  "derivation": [
    "daily interest = 1 000 000 x 0.001 = 1 000; Mar 2..Mar 11 = 10 days = 10 000",
    "payoff Mar 11 = 1 000 000 + 10 000 = 1 010 000; nothing accrues afterwards"
  ],
  "input": {
    "schema_version": 1,
    "model": "daily_accrual",
    "currency": "UAH",
    "balance_basis": "outstanding_principal",
    "allocation": [
      "fees",
      "interest",
      "principal"
    ],
    "payments": [
      {
        "date": "2026-03-11",
        "kind": "early_full",
        "basis": "planned"
      }
    ],
    "opening": {
      "date": "2026-03-01",
      "basis": "contractual_disbursement",
      "principal_minor": 1000000
    },
    "horizon": {
      "end_date": "2026-03-31"
    },
    "interest": {
      "source_metric": "contractual_rate",
      "kind": "fixed",
      "value": "0.1",
      "unit": "percent",
      "per": "day"
    },
    "accrual": {
      "first_day": "day_after_opening",
      "payment_effect": "next_day"
    },
    "rounding": {
      "mode": "half_up",
      "step_minor": 1,
      "interest_stage": "daily"
    },
    "early_repayment": {
      "allowed": true,
      "fee": {
        "kind": "none"
      }
    }
  },
  "expected": {
    "status": "complete",
    "closing": {
      "principal_minor": 0,
      "interest_due_minor": 0,
      "total_minor": 0,
      "loan_closed": true
    },
    "totals": {
      "interest_charged_minor": 10000,
      "payments_minor": 1010000
    },
    "rows_of_kind": {
      "payment": [
        {
          "amount_minor": 1010000,
          "allocated_minor": {
            "fees": 0,
            "interest": 10000,
            "principal": 1000000
          }
        }
      ]
    }
  }
}
